# Variables de entorno del backend de Osiris.
# Copia este archivo a `.env` y ajusta los valores. `.env` está ignorado por git.
# Todas las variables usan el prefijo OSIRIS_ para evitar colisiones con el host.

# Entorno de ejecución: development | staging | production
OSIRIS_ENVIRONMENT=development

# Host donde escucha el servidor (loopback en el host único del restaurante).
OSIRIS_HOST=127.0.0.1

# Puerto del servidor.
OSIRIS_PORT=8000

# Nivel de log: DEBUG | INFO | WARNING | ERROR | CRITICAL
OSIRIS_LOG_LEVEL=INFO
